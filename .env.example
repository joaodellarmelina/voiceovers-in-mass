# Supabase (Project Settings → API Keys). The publishable key is safe in the browser;
# the secret key is server-only (Drive background sync) and must never get a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=https://tdxyomnkkctgvexhoqla.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Optional: only these e-mails can use the app (everyone shares the ElevenLabs credits).
AUTH_ALLOWED_EMAILS=

ELEVENLABS_API_KEY=
# Optional: fixed default voice id for new projects. Without it: Gus on paid plans,
# "Will - Relaxed Optimist" while the account is on Free (library voices are blocked there).
ELEVENLABS_DEFAULT_VOICE_ID=

# Public domain for canonical URLs, sitemap and Open Graph (e.g. https://voiceovers.exemplo.com)
NEXT_PUBLIC_SITE_URL=

# Google Drive sync (optional): OAuth client of type "Web application" with redirect URI
# http://localhost:3000/api/drive/callback. Each user's refresh token is stored in Supabase.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
